#!/usr/bin/env bash
# Installs the toolchains and links the integration into the dev config dir.
set -euo pipefail
cd "$(dirname "$0")/.."

python3 -m pip install --upgrade pip
python3 -m pip install -r requirements-dev.txt
npm install

# Mount the integration into the dev config directory.
mkdir -p custom_components/com_system config/custom_components
ln -sfn ../../custom_components/com_system config/custom_components/com_system
