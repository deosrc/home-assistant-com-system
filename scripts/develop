#!/usr/bin/env bash
# Starts Home Assistant using the dev config directory (debugpy enabled),
# and the Vite dev server for the panel, so panel edits show without a
# rebuild. Set COM_SYSTEM_PANEL_BUNDLE=1 to serve the built bundle instead
# (no Vite). Ports 8123 and 5173 must be forwarded.
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ -z "${COM_SYSTEM_PANEL_BUNDLE:-}" ]]; then
  trap 'kill $(jobs -p) 2>/dev/null' EXIT
  (cd frontend && exec npm run dev --silent) &
  export COM_SYSTEM_PANEL_DEV_URL="http://localhost:5173/src/com-system-panel.ts"
fi

# The configuration includes these files, which are not committed. Empty
# automations and scenes are lists; scripts are a mapping.
[[ -e config/automations.yaml ]] || echo '[]' > config/automations.yaml
[[ -e config/scenes.yaml ]] || echo '[]' > config/scenes.yaml
touch config/scripts.yaml

# PYTHONPATH (set by the devcontainer for the tests) puts the repository's
# custom_components first, which hides config/custom_components, so other
# custom integrations (such as Alexa Media Player) are not found. Home
# Assistant loads Com System through the symlink in config/ instead.
unset PYTHONPATH
hass --config "${PWD}/config" "$@"
